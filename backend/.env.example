# SATARK AI Backend Environment Variables

PROJECT_NAME="SATARK AI - System for Automated Tracking, AI-assisted Routing & Knowledge-driven Action"
API_V1_STR="/api/v1"
SECRET_KEY="satark-ai-sih2026-jharkhand-secret-jwt-key-super-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite fallback for instant zero-dependency execution
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/satark_ai
DATABASE_URL="sqlite:///./satark_ai.db"
POSTGRES_DB="satark_ai"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Service (LangChain + OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
USE_AI_FALLBACK_IF_NO_KEY=true

# Gmail / SMTP Email Settings
# To receive actual real emails in your inbox, set your Gmail address and 16-character App Password below.
# Generate App Password from: Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="satark.ai.sih2026@gmail.com"

# Mobile SMS Gateway (Fast2SMS)
SMS_API_KEY=""
SMS_SENDER_ID="SATARK"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"
