# SATARK AI Backend Environment Variables

PROJECT_NAME="SATARK AI - System for Automated Tracking, AI-assisted Routing & Knowledge-driven Action"
API_V1_STR="/api/v1"
SECRET_KEY="satark-ai-sih2026-jharkhand-secret-jwt-key-super-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite fallback for instant zero-dependency execution
# For PostgreSQL with pgvector: postgresql://postgres:postgres@localhost:5432/satark_ai
DATABASE_URL="sqlite:///./satark_ai.db"
POSTGRES_DB="satark_ai"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Service (LangChain + OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
USE_AI_FALLBACK_IF_NO_KEY=true

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"
