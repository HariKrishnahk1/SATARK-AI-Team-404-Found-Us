# SATARK AI - System for Automated Tracking, AI-assisted Routing & Knowledge-driven Action
# Smart India Hackathon 2026 (PS26043 - Govt of Jharkhand)

# Platform Configuration
PROJECT_NAME="SATARK AI"
API_V1_STR="/api/v1"
SECRET_KEY="satark-ai-sih2026-jharkhand-secret-jwt-key-super-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: SQLite fallback for instant zero-dependency execution
# Production PostgreSQL with pgvector: postgresql://postgres:postgres@localhost:5432/satark_ai
DATABASE_URL="sqlite:///./satark_ai.db"
POSTGRES_DB="satark_ai"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"

# AI Engine Service (LangChain + OpenAI GPT-4o)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o"
USE_AI_FALLBACK_IF_NO_KEY=true

# Real-Time WebSockets
SOCKET_IO_PORT=8008
NEXT_PUBLIC_SOCKET_URL="http://localhost:8008"
NEXT_PUBLIC_API_URL="http://localhost:8008/api/v1"

# CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:5173,http://localhost:5174"
